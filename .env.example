# Nenhuma chave vai para o repositório. Os valores reais ficam em:
# - GitHub > Settings > Secrets and variables > Actions (para as builds)
# - expo.dev > projeto > Environment variables (dentro do app)

# Token do Expo para gerar versões de teste (GitHub Secret)
EXPO_TOKEN=

# Chave do Google Maps Platform / Navigation SDK (Etapa 0, tarefa da navegação)
GOOGLE_MAPS_API_KEY=
