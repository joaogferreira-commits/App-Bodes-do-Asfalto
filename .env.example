# Nenhuma chave vai para o repositório. Os valores reais ficam em:
# - GitHub > Settings > Secrets and variables > Actions (para as builds)
# - expo.dev > projeto > Environment variables (dentro do app)

# Token do Expo para gerar versões de teste (GitHub Secret)
EXPO_TOKEN=

# Chave do Google Maps Platform / Navigation SDK (Etapa 0, tarefa da navegação)
GOOGLE_MAPS_API_KEY=

# Supabase (Etapa 1): endereço do projeto e chave PÚBLICA ("publishable"/anon). Nunca a service_role.
# Ficam nas variáveis de ambiente do EAS (expo.dev > projeto > Environment variables).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Geração de imagens por IA (GitHub Secrets; só o workflow imagens-ia.yml usa)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GEMINI_API_KEY=
