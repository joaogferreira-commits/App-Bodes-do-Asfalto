{
  "version": 8,
  "name": "Bodes do Asfalto v2",
  "metadata": {
    "fonte": "docs/telas/v2/Sistema.dc.html",
    "pendente": "relevo (hillshade) precisa de fonte raster-dem"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> © <a href=\"https://www.openmaptiles.org/\">OpenMapTiles</a> © <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "fundo",
      "type": "background",
      "paint": {
        "background-color": "#15120E"
      }
    },
    {
      "id": "vegetacao",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "forest", "grass", "scrub", "farmland"]]],
      "paint": {
        "fill-color": "#191F16",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "parques",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#191F16",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "urbano",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "commercial", "industrial", "retail"]]],
      "paint": {
        "fill-color": "#1D1813"
      }
    },
    {
      "id": "agua",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#22323D"
      }
    },
    {
      "id": "rios",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#3D6E8F",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 14, 3]
      }
    },
    {
      "id": "limites",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#3A2F25",
        "line-width": 1.2,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "terra-base",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["any", ["==", ["get", "surface"], "unpaved"], ["==", ["get", "class"], "track"]],
        ["!=", ["get", "class"], "path"]
      ],
      "minzoom": 7,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#5A3E1F",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.6, 14, 9]
      }
    },
    {
      "id": "terra",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["any", ["==", ["get", "surface"], "unpaved"], ["==", ["get", "class"], "track"]],
        ["!=", ["get", "class"], "path"]
      ],
      "minzoom": 7,
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#C68A45",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 14, 4],
        "line-dasharray": [2.2, 1.6]
      }
    },
    {
      "id": "estradas-menores",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!", ["any", ["==", ["get", "surface"], "unpaved"], ["==", ["get", "class"], "track"]]],
        ["in", ["get", "class"], ["literal", ["secondary", "tertiary", "minor", "service"]]]
      ],
      "minzoom": 8,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#E9DCC4",
        "line-opacity": 0.38,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 14, 3.5]
      }
    },
    {
      "id": "rodovias-contorno",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!", ["any", ["==", ["get", "surface"], "unpaved"], ["==", ["get", "class"], "track"]]],
        ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#0B0907",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 2.2, 14, 10]
      }
    },
    {
      "id": "rodovias",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["!", ["any", ["==", ["get", "surface"], "unpaved"], ["==", ["get", "class"], "track"]]],
        ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#E9DCC4",
        "line-opacity": 0.85,
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.2, 14, 6.5]
      }
    },
    {
      "id": "rotulos-rodovias",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]],
      "minzoom": 9,
      "layout": {
        "text-field": ["coalesce", ["get", "ref"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": 12,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#F3EADB",
        "text-halo-color": "#0B0907",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "rotulos-terra",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "filter": ["==", ["get", "class"], "track"],
      "minzoom": 12,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#C68A45",
        "text-halo-color": "#0B0907",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "rotulos-rios",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 10,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#7FA6C2",
        "text-halo-color": "#0B0907",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "rotulos-vilas",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["village", "suburb", "neighbourhood"]]],
      "minzoom": 10,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 13
      },
      "paint": {
        "text-color": "#B8A890",
        "text-halo-color": "#0B0907",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "rotulos-cidades",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]],
      "layout": {
        "text-field": ["upcase", ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 12, 10, 17],
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#F3EADB",
        "text-halo-color": "#0B0907",
        "text-halo-width": 2
      }
    }
  ]
}
