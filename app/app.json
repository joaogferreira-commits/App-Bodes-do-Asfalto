{
  "expo": {
    "name": "Bodes do Asfalto",
    "slug": "bodes-do-asfalto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bodesdoasfalto.app"
    },
    "android": {
      "package": "com.bodesdoasfalto.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0A08",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-image",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Bodes do Asfalto usa sua localização para traçar e guiar a rota.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.3.21"
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "./plugins/withNavegacaoGoogle"
    ],
    "owner": "joaogferreira",
    "scheme": "bodesdoasfalto",
    "backgroundColor": "#0C0A08",
    "experiments": {
      "typedRoutes": true
    }
  }
}