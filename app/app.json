{
  "expo": {
    "name": "Bodes do Asfalto",
    "slug": "bodes-do-asfalto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icone/icone.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bodesdoasfalto.app"
    },
    "android": {
      "package": "com.bodesdoasfalto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone/adaptativo-frente.png",
        "backgroundColor": "#0B0907",
        "monochromeImage": "./assets/icone/adaptativo-mono.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icone/abertura.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0907"
        }
      ],
      "expo-dev-client",
      "expo-font",
      "expo-image",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Bodes do Asfalto usa sua localização para traçar e guiar a rota.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Bodes do Asfalto usa suas fotos só quando você escolhe uma para publicar no feed ou no perfil.",
          "cameraPermission": "O Bodes do Asfalto usa a câmera só quando você tira uma foto para publicar no feed ou no perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.3.21"
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "./plugins/withNavegacaoGoogle",
      "./plugins/withAndroidAuto"
    ],
    "owner": "joaogferreira",
    "scheme": "bodesdoasfalto",
    "backgroundColor": "#0C0A08",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "59391c5b-87c0-4b6a-8861-bff6fefd01c6"
      }
    }
  }
}
